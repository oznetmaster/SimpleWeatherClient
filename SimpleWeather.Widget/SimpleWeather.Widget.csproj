<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimpleWeather.Widget</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DisableRuntimeIdentifierFrameworkValidation>true</DisableRuntimeIdentifierFrameworkValidation>

    <!-- Keep custom Program.Main; disable WinUI generated main entry point -->
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <ApplicationIcon>Resources\OpenWeather-Master-Logo-RGB.ico</ApplicationIcon>

    <!-- CsWin32 configuration -->
    <CsWin32InputFile>NativeMethods.txt</CsWin32InputFile>
    <!-- Generate into default Windows.Win32 namespace -->
    <CsWin32Namespace></CsWin32Namespace>
    <!-- Use default visibility (internal) -->
    <CsWin32GeneratedVisibility></CsWin32GeneratedVisibility>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Resources\OpenWeather-Master-Logo-RGB.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors)</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1605</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" Version="63.0.31-preview" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SimpleWeather\SimpleWeather.csproj" />
  </ItemGroup>
  <ItemGroup>
