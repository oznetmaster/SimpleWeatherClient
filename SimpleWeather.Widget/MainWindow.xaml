<Window
    x:Class="SimpleWeather.Widget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SimpleWeather.Widget"
    mc:Ignorable="d">

    <Grid Background="Transparent" Padding="0" UseLayoutRounding="True">
		<Grid.Resources>
			<local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		</Grid.Resources>
         <Grid.ContextFlyout>
             <MenuFlyout Opening="MenuFlyout_OnOpening">
                 <MenuFlyoutItem Text="Refresh" Click="RefreshMenuItem_OnClick" />
                 <MenuFlyoutItem Text="Settings" Click="SettingsMenuItem_OnClick" />
                 <ToggleMenuFlyoutItem Text="Fix location"
                                       Tag="FixLocation"
                                       Click="FixLocationMenuItem_OnClick" />
                 <ToggleMenuFlyoutItem Text="Stay on top"
                                       Tag="AlwaysOnTop"
                                       Click="AlwaysOnTopMenuItem_OnClick" />
                 <ToggleMenuFlyoutItem Text="Compact mode"
                                       Tag="CompactMode"
                                       Click="CompactModeMenuItem_OnClick" />
                 <MenuFlyoutSeparator />
                 <MenuFlyoutItem Text="Close" Click="CloseMenuItem_OnClick" />
             </MenuFlyout>
         </Grid.ContextFlyout>
         <Border x:Name="Card"
                CornerRadius="10"
                Padding="0"
                PointerPressed="Card_OnPointerPressed">
             <Grid>
                 <Border CornerRadius="10"
                         Background="{ThemeResource SystemControlAcrylicWindowMediumHighBrush}"
                         Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                 <!-- Compact background -->
                 <Border CornerRadius="10"
                         BorderThickness="0"
                         Background="Transparent"
                         Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                     <Image Stretch="UniformToFill"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="0"
                            Source="{Binding CompactBackground}" />
                 </Border>

                 <Grid Visibility="{Binding FullLayoutVisibility}"
                       RowSpacing="2"
 					  Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Location}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Tapped="Location_Tapped" />
                            <TextBlock Text="{Binding UpdatedDisplay}"
                                       FontSize="11"
                                       Foreground="#B3FFFFFF" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Spacing="2"
                                    HorizontalAlignment="Right">
                            <Image Width="56"
                                   Height="56"
                                   Source="{Binding IconUrl}"
                                   Stretch="Uniform" />
                            <TextBlock Text="{Binding Condition}"
                                       FontSize="11"
                                       Foreground="#CCFFFFFF"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Temperature}"
                                       FontSize="38"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="{Binding HighLow}"
                                       FontSize="11"
                                       Foreground="#CCFFFFFF" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Wind"
                                       FontSize="10"
                                       Foreground="#B3FFFFFF" />
                            <TextBlock Text="{Binding Wind}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Humidity"
                                       FontSize="10"
                                       Foreground="#B3FFFFFF" />
                            <TextBlock Text="{Binding Humidity}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Status"
                                       FontSize="10"
                                       Foreground="#B3FFFFFF" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="11"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="#F5F5F5" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3"
                                HorizontalAlignment="Right"
                                FontSize="9.5"
                                Foreground="#80FFFFFF">
                        <Run Text="Weather data by " />
                        <Hyperlink NavigateUri="https://openweathermap.org/terms"
                                   ToolTipService.ToolTip="OpenWeather license terms">
                            <Run Text="OpenWeather" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>
				<!-- Compact overlay content (above background image) -->
				<Grid Visibility="{Binding CompactLayoutVisibility}"
		      RowSpacing="0"
		      ColumnSpacing="3"
		      VerticalAlignment="Stretch"
		      Margin="0"
		      Padding="10,3,10,6">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Row="0"
				           Grid.Column="1"
				           Text="{Binding CompactTemperature}"
				           FontSize="36"
				           FontWeight="SemiBold"
				           Foreground="{Binding CompactTemperatureForeground}"
				           HorizontalAlignment="Stretch"
				           TextAlignment="Right"
				           Margin="0,-5,0,0" />

				<TextBlock Grid.Row="1"
				           Grid.Column="0"
				           Grid.ColumnSpan="2"
				           VerticalAlignment="Top"
				           Text="{Binding CompactLocation}"
				           FontSize="12"
				           Foreground="{Binding CompactLocationForeground}"
				           HorizontalAlignment="Stretch"
				           TextAlignment="Right"
				           TextTrimming="CharacterEllipsis"
				           Margin="0,-7,0,0"
				           Tapped="Location_Tapped" />

				<TextBlock Grid.Row="2"
				           Grid.Column="0"
				           Grid.ColumnSpan="2"
				           VerticalAlignment="Bottom"
				           Text="Weather by OpenWeather"
				           FontSize="9.5"
				           Foreground="{Binding CompactLocationForeground}"
				           HorizontalAlignment="Right"
				           TextAlignment="Right"
				           TextTrimming="CharacterEllipsis"
				           Margin="0,0,0,0" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</Window>
