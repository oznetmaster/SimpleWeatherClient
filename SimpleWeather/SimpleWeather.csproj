<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <RootNamespace>SimpleWeather</RootNamespace>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
	  <LangVersion>latest</LangVersion>
	  <Nullable>enable</Nullable>
	  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	  <AnalysisLevel>latest-recommended</AnalysisLevel>
	  <EnableNETAnalyzers>true</EnableNETAnalyzers>
	  <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
	  <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
	  <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <RestoreTargetFrameworks>net472;net10.0</RestoreTargetFrameworks>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <BaseOutputPath>bin\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

      <!-- Migrated from AssemblyInfo.cs -->
      <AssemblyTitle>SimpleWeather</AssemblyTitle>
      <Description>Dual-targeted OpenWeather client library with .NET Framework 4.7.2 and .NET 10 support, adapted from the original Banovvv/SimpleWeather project.</Description>
      <Company>Neil Colvin</Company>
      <Product>SimpleWeatherClient</Product>
      <Copyright>Copyright © 2026 Neil Colvin</Copyright>
      <AssemblyVersion>2.0.0.0</AssemblyVersion>
      <FileVersion>2.0.0.0</FileVersion>
      <ComVisible>false</ComVisible>
      <Platforms>AnyCPU</Platforms>
      <PackageId>SimpleWeatherClient</PackageId>
      <Version>2.0.0</Version>
      <PackageTags>weather;openweather;forecast;desktop;net472;net10</PackageTags>
      <Authors>Neil Colvin</Authors>
      <PackageProjectUrl>https://github.com/oznetmaster/SimpleWeatherClient</PackageProjectUrl>
      <RepositoryUrl>https://github.com/oznetmaster/SimpleWeatherClient.git</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
      <IncludeSymbols>true</IncludeSymbols>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
      <PublishRepositoryUrl>true</PublishRepositoryUrl>
      <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
	  <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	  <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Net472ReferenceAssemblies>$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2</Net472ReferenceAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
		<Optimize>true</Optimize>
	</PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.12" Condition="'$(TargetFramework)' == 'net472'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	  <PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
	  <PackageReference Include="RequiredMemberAttribute" Version="1.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="build\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <Target Name="GenerateDocumentationPdf" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net472' and '$(IsBuildingProject)' == 'true'">
    <PropertyGroup>
      <DocfxConfig>$(MSBuildProjectDirectory)\..\docfx\docfx.json</DocfxConfig>
      <DocfxSiteDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)docfx-site</DocfxSiteDir>
      <DocfxFinalPdf>$(TargetDir)SimpleWeather.docfx.pdf</DocfxFinalPdf>
      <DocfxPdfOutput>$(DocfxSiteDir)\toc.pdf</DocfxPdfOutput>
      <DocfxReferenceDir>$(MSBuildProjectDirectory)\..\docfx\references</DocfxReferenceDir>
      <SystemNetHttpReference>$(Net472ReferenceAssemblies)\System.Net.Http.dll</SystemNetHttpReference>
    </PropertyGroup>
    <MakeDir Directories="$(DocfxReferenceDir)" />
    <Copy SourceFiles="$(SystemNetHttpReference)" DestinationFiles="$(DocfxReferenceDir)\System.Net.Http.dll" SkipUnchangedFiles="true" />
    <Exec Command="dotnet tool restore" />
    <Exec Command="dotnet tool run docfx metadata &quot;$(DocfxConfig)&quot; --logLevel Error --property TargetFramework=net472;Configuration=$(Configuration)" />
    <Exec Command="dotnet tool run docfx build &quot;$(DocfxConfig)&quot; --output &quot;$(DocfxSiteDir)&quot;" />
    <Exec Command="dotnet tool run docfx pdf &quot;$(DocfxConfig)&quot; --output &quot;$(DocfxSiteDir)&quot;" />
    <Copy SourceFiles="$(DocfxPdfOutput)" DestinationFiles="$(DocfxFinalPdf)" Condition="Exists('$(DocfxPdfOutput)')" />
  </Target>
</Project>
