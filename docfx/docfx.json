{
  "metadata": [
    {
      "src": [
        {
          "files": [ "SimpleWeather/SimpleWeather.csproj" ],
          "cwd": ".."
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml" ]
      },
      {
        "files": [ "articles/**.md" ]
      },
      {
        "files": [ "index.md" ]
      },
      {
        "files": [ "toc.yml" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      },
      {
        "files": [ "styles/**" ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "SimpleWeather API",
      "pdf": true
    },
    "template": [
      "default",
      "modern"
    ]
  }
}
