<Window x:Class="SimpleWeather.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SimpleWeather Desktop"
        Height="520"
        Width="920"
        MinWidth="720"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="8"
                Padding="14"
                Background="#f2f6fb"
                BorderBrush="#d0d8e2"
                BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <StackPanel.Resources>
                    <Style TargetType="FrameworkElement">
                        <Setter Property="Margin" Value="0,4,0,4" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Location"
                           FontWeight="Bold"
                           FontSize="16" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="City" />
                        <ComboBox x:Name="CityComboBox"
                                  IsEditable="True"
                                  SelectionChanged="CityComboBox_OnSelectionChanged"
                                  MinWidth="200"
                                  Text="Seattle" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="State (optional)" />
                        <ComboBox x:Name="StateComboBox"
                                  IsEditable="True"
                                  MinWidth="200" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,12,0">
                        <TextBlock Text="Country (optional)" />
                        <ComboBox x:Name="CountryComboBox"
                                  IsEditable="True"
                                  MinWidth="200" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                        <TextBlock Text="Units" />
                        <ComboBox x:Name="UnitsComboBox"
                                  MinWidth="200" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton"
                            Content="Fetch weather"
                            Click="RefreshButton_OnClick"
                            Padding="22,6"
                            Background="#005FB8"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" VerticalAlignment="Center">
             <ProgressBar x:Name="BusyIndicator"
                          Width="160"
                          Height="6"
                          Foreground="#005FB8"
                          Visibility="Collapsed"
                          IsIndeterminate="True" />
            <TextBlock x:Name="StatusText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#3c3c3c"
                       Text="Provide a location and click Fetch weather." />
         </StackPanel>

        <Border Grid.Row="2"
                Margin="0,20,0,20"
                Padding="20"
                Background="White"
                BorderBrush="#d0d8e2"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="City" Grid.Row="0" />
                <TextBlock x:Name="CityValueText"
                           Grid.Row="0"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Text="-" />

                <TextBlock Text="Coordinates" Grid.Row="1" />
                <TextBlock x:Name="CoordinatesValueText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="-" />

                <TextBlock Text="Condition" Grid.Row="2" />
                <TextBlock x:Name="ConditionValueText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="-" />

                <TextBlock Text="Temperature" Grid.Row="3" />
                <TextBlock x:Name="TemperatureValueText"
                           Grid.Row="3"
                           Grid.Column="1"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="-" />

                <TextBlock Text="Feels like" Grid.Row="4" />
                <TextBlock x:Name="FeelsLikeValueText"
                           Grid.Row="4"
                           Grid.Column="1"
                           Text="-" />

                <TextBlock Text="Humidity" Grid.Row="5" />
                <TextBlock x:Name="HumidityValueText"
                           Grid.Row="5"
                           Grid.Column="1"
                           Text="-" />

                <TextBlock Text="Pressure" Grid.Row="6" />
                <TextBlock x:Name="PressureValueText"
                           Grid.Row="6"
                           Grid.Column="1"
                           Text="-" />

                <TextBlock Text="Wind" Grid.Row="7" />
                <TextBlock x:Name="WindValueText"
                           Grid.Row="7"
                           Grid.Column="1"
                           Text="-" />

                <TextBlock Text="Visibility" Grid.Row="8" />
                <TextBlock x:Name="VisibilityValueText"
                           Grid.Row="8"
                           Grid.Column="1"
                           Text="-" />

                <TextBlock Text="Timezone" Grid.Row="9" />
                <TextBlock x:Name="TimezoneValueText"
                           Grid.Row="9"
                           Grid.Column="1"
                           Text="-" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Weather data provided by OpenWeather"
                   Foreground="#6b6b6b"
                   FontSize="12"
                   HorizontalAlignment="Right" />
    </Grid>
</Window>
